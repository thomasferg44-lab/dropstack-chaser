# Supabase — get these from Settings > API in your Supabase project.
# The send-nudge Netlify Function reads these two as well, to verify that the
# caller has a real owner session before it will send anything.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend — server-side only, used by Netlify Functions.
# NEVER prefix this with VITE_ (that would expose it to the browser).
RESEND_API_KEY=

# Safety flag. Email is sent ONLY when this is exactly "false" — any other
# value, including missing, blocks the send and logs it instead. Set it to
# "false" in the Netlify dashboard when the client goes live, never here.
DEV_BLOCK_REAL_SENDS=true
